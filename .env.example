APP_ENV=development
SITE_NAME=CareerAtlas
SITE_URL=http://localhost:3000
BRAND_COLOR=#123d32
SUPPORT_EMAIL=
DATABASE_URL=postgresql://careeratlas:careeratlas@localhost:5432/careeratlas
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_TRANSPORT=development
RESEND_API_KEY=
EMAIL_FROM=CareerAtlas <jobs@your-verified-domain.example>
DEMO_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_DAILY_LIMIT=100
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
ANALYTICS_ENABLED=false
SOURCE_BROWSER_ENABLED=false
