APP_ENV=development
SITE_NAME=CareerAtlas
SITE_URL=http://localhost:3000
BRAND_COLOR=#123d32
SUPPORT_EMAIL=
DATABASE_URL=postgresql://careeratlas:careeratlas@localhost:5432/careeratlas
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_TRANSPORT=development
RESEND_API_KEY=
EMAIL_FROM=CareerAtlas <jobs@your-verified-domain.example>
DEMO_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_DAILY_LIMIT=100
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
ANALYTICS_ENABLED=false
SOURCE_BROWSER_ENABLED=false
# Apify API token for Actor runs or dataset imports:
APIFY_TOKEN=
# Set to true to let the worker import fresh jobs on a schedule:
APIFY_IMPORT_ENABLED=false
APIFY_IMPORT_INTERVAL_HOURS=24
# APIFY_ACTOR_ID=fantastic-jobs~career-site-job-listing-api
# Each employer must have a separately approved and enabled manual_apify source.
# Only needed for an approved licensed source with config.credentialEnv set to this name:
# JOB_SOURCE_TOKEN_EXAMPLE=
# Optional real-broker integration test (isolated Redis only):
# TEST_REDIS_URL=redis://localhost:6379

# Optional real PostgreSQL ingestion tests; test-only role must have CREATEDB.
# Uses and removes unique jobx_test_* databases; never use production services.
# TEST_POSTGRES_URL=postgresql://careeratlas:careeratlas@localhost:5432/careeratlas

# Optional bounded discovery from operator-supplied HTTPS seed URLs. Candidates always require review.
JOB_DISCOVERY_ENABLED=false
JOB_DISCOVERY_SEEDS=
JOB_DISCOVERY_INTERVAL_MINUTES=60

# Public, attribution-required keyless remote search. On by default; set false to disable.
FEDERATED_HIMALAYAS_ENABLED=true
# Optional credentialed federated search for all signed-in candidates.
# Every provider is OFF until an operator has reviewed display terms and supplied keys.
# Adzuna: use approved national markets (up to 2 per search). Brand artwork is not bundled.
FEDERATED_ADZUNA_ENABLED=false
FEDERATED_ADZUNA_APP_ID=
FEDERATED_ADZUNA_APP_KEY=
FEDERATED_ADZUNA_MARKETS=
FEDERATED_ADZUNA_ATTRIBUTION_LOGO_URL=
# USAJOBS: request a search API key and supply its registered contact email.
FEDERATED_USAJOBS_ENABLED=false
FEDERATED_USAJOBS_API_KEY=
FEDERATED_USAJOBS_EMAIL=
# Jooble: keys are national-market-specific. Example region: ng, us, gb, de.
FEDERATED_JOOBLE_ENABLED=false
FEDERATED_JOOBLE_API_KEY=
FEDERATED_JOOBLE_REGION=

# Operator must verify the provider's legal storage/attribution rights before enabling.
# Comma-separated: adzuna,usajobs,jooble. Empty means no external lead retention.
JOB_EXTERNAL_SAVE_PROVIDERS=

# Bounded recurring provider searches: requires approved provider storage rights and keys.
# JSON array, max 10: [{"q":"accountant","provider":"usajobs","location":"Chicago"}]
# Jooble requires its configured national market and explicit location.
JOB_AUTONOMOUS_PROVIDER_DISCOVERY_ENABLED=false
JOB_AUTONOMOUS_PROVIDER_DISCOVERY_SEEDS=
JOB_AUTONOMOUS_PROVIDER_DISCOVERY_INTERVAL_HOURS=24
